{
  "name": "contentguard-real-models",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:content": "esbuild content.js --bundle --format=iife --outfile=dist/content.js --minify --global-name=ContentGuard",
    "build:background": "esbuild background.js --bundle --format=iife --outfile=dist/background.js --minify",
    "build": "npm run build:content && npm run build:background"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}